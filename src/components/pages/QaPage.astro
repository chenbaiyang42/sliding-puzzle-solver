---
import { createT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Hero Section -->
  <div class="text-center">
    <h1 class="text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl md:text-6xl">
      <span class="block text-primary">{t('qa.hero.title')}</span>
    </h1>
    <p class="mt-3 max-w-md mx-auto text-base text-gray-500 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl">
      {t('qa.hero.subtitle')}
    </p>
  </div>

  <!-- FAQ Section -->
  <div class="mt-12 max-w-3xl mx-auto">
    <div class="space-y-8">
      <!-- Performance Questions -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900">{t('qa.section.performance')}</h2>
        
        <div class="mt-6 space-y-6">
          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.perf.q1.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p class="mb-3">{t('qa.perf.q1.p1')}</p>
                <ul class="list-disc pl-5 space-y-2">
                  <li><strong>{t('qa.perf.q1.8.label')}</strong> {t('qa.perf.q1.8.value')}</li>
                  <li>
                    <strong>{t('qa.perf.q1.15.label')}</strong>
                    <ul class="list-disc pl-5 mt-1">
                      <li>{t('qa.perf.q1.15.pattern')}</li>
                      <li>{t('qa.perf.q1.15.astarManhattan')}</li>
                      <li>{t('qa.perf.q1.15.astarLinear')}</li>
                      <li>{t('qa.perf.q1.15.ida')}</li>
                    </ul>
                  </li>
                  <li><strong>{t('qa.perf.q1.large.label')}</strong> {t('qa.perf.q1.large.value')}</li>
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.perf.q2.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p class="mb-3">{t('qa.perf.q2.p1')}</p>
                <ul class="list-disc pl-5 space-y-2">
                  <li><strong>{t('qa.perf.q2.pattern.label')}</strong> {t('qa.perf.q2.pattern.value')}</li>
                  <li><strong>{t('qa.perf.q2.astarManhattan.label')}</strong> {t('qa.perf.q2.astarManhattan.value')}</li>
                  <li><strong>{t('qa.perf.q2.astarLinear.label')}</strong> {t('qa.perf.q2.astarLinear.value')}</li>
                  <li><strong>{t('qa.perf.q2.ida.label')}</strong> {t('qa.perf.q2.ida.value')}</li>
                  <li><strong>{t('qa.perf.q2.bibfs.label')}</strong> {t('qa.perf.q2.bibfs.value')}</li>
                </ul>
                <p class="mt-3">{t('qa.perf.q2.p2')}</p>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.perf.q3.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.perf.q3.p1')}</p>
                <ul class="list-disc pl-5 space-y-2 mt-2">
                  <li><strong>{t('qa.perf.q3.f1.label')}</strong> {t('qa.perf.q3.f1.value')}</li>
                  <li><strong>{t('qa.perf.q3.f2.label')}</strong> {t('qa.perf.q3.f2.value')}</li>
                  <li><strong>{t('qa.perf.q3.f3.label')}</strong> {t('qa.perf.q3.f3.value')}</li>
                  <li><strong>{t('qa.perf.q3.f4.label')}</strong> {t('qa.perf.q3.f4.value')}</li>
                </ul>
                <p class="mt-3">{t('qa.perf.q3.p2')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Technical Questions -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900">{t('qa.section.technical')}</h2>
        
        <div class="mt-6 space-y-6">
          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.tech.q1.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p class="mb-3">{t('qa.tech.q1.p1')}</p>
                <ul class="list-disc pl-5 space-y-3">
                  <li>
                    <strong>{t('qa.tech.q1.pattern.label')}</strong> {t('qa.tech.q1.pattern.value')}
                  </li>
                  <li>
                    <strong>{t('qa.tech.q1.astar.label')}</strong> {t('qa.tech.q1.astar.value')}
                    <ul class="list-disc pl-5 mt-1">
                      <li><strong>{t('qa.tech.q1.manhattan.label')}</strong> {t('qa.tech.q1.manhattan.value')}</li>
                      <li><strong>{t('qa.tech.q1.misplaced.label')}</strong> {t('qa.tech.q1.misplaced.value')}</li>
                      <li><strong>{t('qa.tech.q1.linear.label')}</strong> {t('qa.tech.q1.linear.value')}</li>
                    </ul>
                  </li>
                  <li>
                    <strong>{t('qa.tech.q1.ida.label')}</strong> {t('qa.tech.q1.ida.value')}
                  </li>
                  <li>
                    <strong>{t('qa.tech.q1.bibfs.label')}</strong> {t('qa.tech.q1.bibfs.value')}
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.tech.q2.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.tech.q2.p1')}</p>
                <p class="mt-3">{t('qa.tech.q2.p2')}</p>
                <ul class="list-disc pl-5 space-y-2 mt-2">
                  <li>{t('qa.tech.q2.odd')}</li>
                  <li>
                    {t('qa.tech.q2.even.intro')}
                    <ul class="list-disc pl-5 mt-1">
                      <li>{t('qa.tech.q2.even.case1')}</li>
                      <li>{t('qa.tech.q2.even.case2')}</li>
                    </ul>
                  </li>
                </ul>
                <p class="mt-3">{t('qa.tech.q2.p3')}</p>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.tech.q3.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.tech.q3.p1')}</p>
                <ul class="list-disc pl-5 space-y-2 mt-2">
                  <li><strong>{t('qa.tech.q3.s1.label')}</strong> {t('qa.tech.q3.s1.value')}</li>
                  <li><strong>{t('qa.tech.q3.s2.label')}</strong> {t('qa.tech.q3.s2.value')}</li>
                  <li><strong>{t('qa.tech.q3.s3.label')}</strong> {t('qa.tech.q3.s3.value')}</li>
                </ul>
                <p class="mt-3">{t('qa.tech.q3.p2')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Usage Questions -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900">{t('qa.section.usage')}</h2>
        
        <div class="mt-6 space-y-6">
          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.use.q1.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.use.q1.p1')}</p>
                <ol class="list-decimal pl-5 space-y-2 mt-2">
                  <li>{t('qa.use.q1.s1')}</li>
                  <li>{t('qa.use.q1.s2')}</li>
                  <li>{t('qa.use.q1.s3')}</li>
                  <li>{t('qa.use.q1.s4')}</li>
                  <li>{t('qa.use.q1.s5')}</li>
                </ol>
                <p class="mt-3">{t('qa.use.q1.p2')}</p>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.use.q2.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.use.q2.p1')}</p>
                <ul class="list-disc pl-5 space-y-2 mt-2">
                  <li>{t('qa.use.q2.s1')}</li>
                  <li>{t('qa.use.q2.s2')}</li>
                  <li>{t('qa.use.q2.s3')}</li>
                </ul>
                <p class="mt-3">{t('qa.use.q2.p2')}</p>
              </div>
            </div>
          </div>

          <div class="bg-white shadow overflow-hidden rounded-lg">
            <div class="px-4 py-5 sm:p-6">
              <h3 class="text-lg leading-6 font-medium text-gray-900">{t('qa.use.q3.title')}</h3>
              <div class="mt-2 text-gray-600">
                <p>{t('qa.use.q3.p1')}</p>
                <ul class="list-disc pl-5 space-y-2 mt-2">
                  <li>{t('qa.use.q3.s1')}</li>
                  <li>{t('qa.use.q3.s2')}</li>
                </ul>
                <p class="mt-3">{t('qa.use.q3.p2')}</p>
                <p class="mt-3">{t('qa.use.q3.p3')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


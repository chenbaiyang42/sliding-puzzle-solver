---
import { createT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  prefix: string;
}

const { locale, prefix } = Astro.props;
const t = createT(locale);
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="text-center mb-12">
    <h1 class="text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl">
      <span class="block text-primary">{t('terms.hero.title')}</span>
    </h1>
    <p class="mt-3 max-w-2xl mx-auto text-xl text-gray-500">
      {t('terms.hero.subtitle')}
    </p>
  </div>

  <div class="prose prose-lg max-w-none">
    <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">{t('terms.title')}</h2>
      
      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s1.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s1.body')}</p>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s2.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s2.body')}</p>
      <ul class="list-disc pl-6 mb-4 text-gray-700">
        <li>{t('terms.s2.l1')}</li>
        <li>{t('terms.s2.l2')}</li>
        <li>{t('terms.s2.l3')}</li>
        <li>{t('terms.s2.l4')}</li>
      </ul>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s3.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s3.body')}</p>
      <ul class="list-disc pl-6 mb-4 text-gray-700">
        <li>{t('terms.s3.l1')}</li>
        <li>{t('terms.s3.l2')}</li>
        <li>{t('terms.s3.l3')}</li>
        <li>{t('terms.s3.l4')}</li>
      </ul>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s4.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s4.body')}</p>
      <ul class="list-disc pl-6 mb-4 text-gray-700">
        <li>{t('terms.s4.l1')}</li>
        <li>{t('terms.s4.l2')}</li>
        <li>{t('terms.s4.l3')}</li>
        <li>{t('terms.s4.l4')}</li>
      </ul>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s5.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s5.body')}</p>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s6.title')}</h3>
      <p class="text-gray-700 mb-4">
        {t('terms.s6.body')}{' '}
        <a href={`${prefix}/privacy-en`} class="text-primary hover:underline">{t('terms.s6.linkText')}</a>.
      </p>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s7.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s7.body')}</p>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s8.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s8.body')}</p>

      <h3 class="text-xl font-semibold text-gray-900 mt-8 mb-4">{t('terms.s9.title')}</h3>
      <p class="text-gray-700 mb-4">{t('terms.s9.body')}</p>
      <p class="text-gray-700">
        {t('terms.s9.emailLabel')}{' '}
        <a href="mailto:support@sliding-puzzle-solver.com" class="text-primary hover:underline">support@sliding-puzzle-solver.com</a>
      </p>

      <div class="mt-12 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-500">
          {t('terms.updated')}: {new Date().toLocaleDateString('en-US')}
        </p>
      </div>
    </div>
  </div>
</div>


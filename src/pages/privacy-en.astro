---
import Layout from '../layouts/Layout.astro';
import PrivacyPage from '../components/pages/PrivacyPage.astro';
import { createT, normalizeLocale } from '../i18n';

const locale = normalizeLocale(Astro.url.pathname.split('/').filter(Boolean)[0]);
const t = createT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<Layout 
  title={t('privacy.meta.title')}
  description={t('privacy.meta.desc')}
  canonical={`https://sliding-puzzle-solver.com${prefix}/privacy-en`}
>
  <PrivacyPage locale={locale} />
</Layout> 
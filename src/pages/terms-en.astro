---
import Layout from '../layouts/Layout.astro';
import TermsPage from '../components/pages/TermsPage.astro';
import { createT, normalizeLocale } from '../i18n';

const locale = normalizeLocale(Astro.url.pathname.split('/').filter(Boolean)[0]);
const t = createT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<Layout 
  title={t('terms.meta.title')}
  description={t('terms.meta.desc')}
  canonical={`https://sliding-puzzle-solver.com${prefix}/terms-en`}
>
  <TermsPage locale={locale} prefix={prefix} />
</Layout> 
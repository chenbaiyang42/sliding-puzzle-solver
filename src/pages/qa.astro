---
import Layout from '../layouts/Layout.astro';
import QaPage from '../components/pages/QaPage.astro';
import { createT, normalizeLocale } from '../i18n';

const locale = normalizeLocale(Astro.url.pathname.split('/').filter(Boolean)[0]);
const t = createT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<Layout 
  title={t('qa.meta.title')}
  description={t('qa.meta.desc')}
  canonical={`https://sliding-puzzle-solver.com${prefix}/qa`}
>
  <QaPage locale={locale} />
</Layout> 
---
import Layout from '../../layouts/Layout.astro';
import PrivacyPage from '../../components/pages/PrivacyPage.astro';
import { createT, locales, normalizeLocale } from '../../i18n';

export function getStaticPaths() {
  return locales
    .filter((l) => l !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const locale = normalizeLocale(Astro.params.lang);
const t = createT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<Layout 
  title={t('privacy.meta.title')}
  description={t('privacy.meta.desc')}
  canonical={`https://sliding-puzzle-solver.com${prefix}/privacy-en`}
>
  <PrivacyPage locale={locale} />
</Layout>

